@model WarehouseAccounting.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

<form asp-controller="Categories"
      asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <!-- المفتاح القديم للسجل -->
    <input type="hidden" name="id" value="@Model.categ_num" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="categ_num" class="control-label">
            Category Number
        </label>

        <input asp-for="categ_num"
               class="form-control" />

        <span asp-validation-for="categ_num"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="categ_name" class="control-label">
            Category Name
        </label>

        <input asp-for="categ_name"
               class="form-control" />

        <span asp-validation-for="categ_name"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="price" class="control-label">
            Price
        </label>

        <input asp-for="price"
               class="form-control" />

        <span asp-validation-for="price"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="qntt" class="control-label">
            Qntt
        </label>

        <input asp-for="qntt"
               class="form-control" />

        <span asp-validation-for="qntt"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="qnty" class="control-label">
            Qnty
        </label>

        <input asp-for="qnty"
               class="form-control" />

        <span asp-validation-for="qnty"
              class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="group_num" class="control-label">
            Group Number
        </label>

        <input asp-for="group_num"
               class="form-control" />

        <span asp-validation-for="group_num"
              class="text-danger"></span>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">
            Save
        </button>

        <a asp-controller="Categories"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}