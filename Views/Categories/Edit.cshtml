@model WarehouseAccounting.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

<form asp-controller="Categories"
      asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <!-- المفتاح الأصلي للسجل -->
    <input type="hidden"
           name="id"
           value="@Model.categ_num" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>


    <!-- Category Number -->
    <div class="form-group mb-3">
        <label class="control-label">
            Category Number
        </label>

        <!-- للعرض فقط، لا نسمح بتغييره -->
        <input class="form-control"
               value="@Model.categ_num"
               readonly />
    </div>


    <!-- Category Name -->
    <div class="form-group mb-3">
        <label asp-for="categ_name" class="control-label">
            Category Name
        </label>

        <input asp-for="categ_name"
               class="form-control" />

        <span asp-validation-for="categ_name"
              class="text-danger"></span>
    </div>


    <!-- Price -->
    <div class="form-group mb-3">
        <label asp-for="price" class="control-label">
            Price
        </label>

        <input asp-for="price"
               class="form-control" />

        <span asp-validation-for="price"
              class="text-danger"></span>
    </div>


    <!-- Qntt -->
    <div class="form-group mb-3">
        <label asp-for="qntt" class="control-label">
            Qntt
        </label>

        <input asp-for="qntt"
               class="form-control" />

        <span asp-validation-for="qntt"
              class="text-danger"></span>
    </div>


    <!-- Qnty -->
    <div class="form-group mb-3">
        <label asp-for="qnty" class="control-label">
            Qnty
        </label>

        <input asp-for="qnty"
               class="form-control" />

        <span asp-validation-for="qnty"
              class="text-danger"></span>
    </div>


    <!-- Quantity Type -->
    <div class="form-group mb-3">
        <label asp-for="qntytype" class="control-label">
            Quantity Type
        </label>

        <input asp-for="qntytype"
               class="form-control" />

        <span asp-validation-for="qntytype"
              class="text-danger"></span>
    </div>


    <!-- Size -->
    <div class="form-group mb-3">
        <label asp-for="size" class="control-label">
            Size
        </label>

        <input asp-for="size"
               class="form-control" />

        <span asp-validation-for="size"
              class="text-danger"></span>
    </div>


    <!-- Color -->
    <div class="form-group mb-3">
        <label asp-for="color" class="control-label">
            Color
        </label>

        <input asp-for="color"
               class="form-control" />

        <span asp-validation-for="color"
              class="text-danger"></span>
    </div>


    <!-- Weight -->
    <div class="form-group mb-3">
        <label asp-for="weight" class="control-label">
            Weight
        </label>

        <input asp-for="weight"
               class="form-control" />

        <span asp-validation-for="weight"
              class="text-danger"></span>
    </div>


    <!-- Model -->
    <div class="form-group mb-3">
        <label asp-for="model" class="control-label">
            Model
        </label>

        <input asp-for="model"
               class="form-control" />

        <span asp-validation-for="model"
              class="text-danger"></span>
    </div>


    <!-- Company -->
    <div class="form-group mb-3">
        <label asp-for="company" class="control-label">
            Company
        </label>

        <input asp-for="company"
               class="form-control" />

        <span asp-validation-for="company"
              class="text-danger"></span>
    </div>


    <!-- Production Date -->
    <div class="form-group mb-3">
        <label asp-for="production_date" class="control-label">
            Production Date
        </label>

        <input asp-for="production_date"
               type="date"
               class="form-control" />

        <span asp-validation-for="production_date"
              class="text-danger"></span>
    </div>


    <!-- Expiry Date -->
    <div class="form-group mb-3">
        <label asp-for="expiry_date" class="control-label">
            Expiry Date
        </label>

        <input asp-for="expiry_date"
               type="date"
               class="form-control" />

        <span asp-validation-for="expiry_date"
              class="text-danger"></span>
    </div>


    <!-- Group Name -->
    <div class="form-group mb-3">
        <label asp-for="group_name" class="control-label">
            Group Name
        </label>

        <input asp-for="group_name"
               class="form-control" />

        <span asp-validation-for="group_name"
              class="text-danger"></span>
    </div>


    <!-- Group Number -->
    <div class="form-group mb-3">
        <label asp-for="group_num" class="control-label">
            Group Number
        </label>

        <input asp-for="group_num"
               class="form-control" />

        <span asp-validation-for="group_num"
              class="text-danger"></span>
    </div>


    <div class="mt-3">

        <button type="submit"
                class="btn btn-primary">
            Save
        </button>

        <a asp-controller="Categories"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}