@model WarehouseAccounting.Models.Category

@{
    ViewData["Title"] = "تعديل المنتج";
}

<h2>تعديل المنتج</h2>

<form asp-controller="Categories"
      asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <!-- الرقم القديم للسجل -->
    <input type="hidden"
           name="oldId"
           value="@Model.Id" />

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <!-- رقم المنتج -->
    <div class="mb-3">
        <label asp-for="Id">رقم المنتج</label>

        <input asp-for="Id"
               class="form-control" />

        <span asp-validation-for="Id"
              class="text-danger"></span>
    </div>

    <!-- اسم المنتج -->
    <div class="mb-3">
        <label asp-for="Name">اسم المنتج</label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <!-- السعر -->
    <div class="mb-3">
        <label asp-for="Price">السعر</label>

        <input asp-for="Price"
               class="form-control" />

        <span asp-validation-for="Price"
              class="text-danger"></span>
    </div>

    <!-- الكمية -->
    <div class="mb-3">
        <label asp-for="Qntt">الكمية</label>

        <input asp-for="Qntt"
               class="form-control" />

        <span asp-validation-for="Qntt"
              class="text-danger"></span>
    </div>

    <!-- الوحدة -->
    <div class="mb-3">
        <label asp-for="Qnty">الوحدة</label>

        <input asp-for="Qnty"
               class="form-control" />

        <span asp-validation-for="Qnty"
              class="text-danger"></span>
    </div>

    <!-- نوع الوحدة -->
    <div class="mb-3">
        <label asp-for="QntyType">نوع الوحدة</label>

        <input asp-for="QntyType"
               class="form-control" />

        <span asp-validation-for="QntyType"
              class="text-danger"></span>
    </div>

    <!-- الحجم -->
    <div class="mb-3">
        <label asp-for="Size">الحجم</label>

        <input asp-for="Size"
               class="form-control" />

        <span asp-validation-for="Size"
              class="text-danger"></span>
    </div>

    <!-- اللون -->
    <div class="mb-3">
        <label asp-for="Color">اللون</label>

        <input asp-for="Color"
               class="form-control" />

        <span asp-validation-for="Color"
              class="text-danger"></span>
    </div>

    <!-- الوزن -->
    <div class="mb-3">
        <label asp-for="Weight">الوزن</label>

        <input asp-for="Weight"
               class="form-control" />

        <span asp-validation-for="Weight"
              class="text-danger"></span>
    </div>

    <!-- الموديل -->
    <div class="mb-3">
        <label asp-for="Model">الموديل</label>

        <input asp-for="Model"
               class="form-control" />

        <span asp-validation-for="Model"
              class="text-danger"></span>
    </div>

    <!-- الشركة -->
    <div class="mb-3">
        <label asp-for="Company">الشركة</label>

        <input asp-for="Company"
               class="form-control" />

        <span asp-validation-for="Company"
              class="text-danger"></span>
    </div>

    <!-- تاريخ الإنتاج -->
    <div class="mb-3">
        <label asp-for="ProductionDate">
            تاريخ الإنتاج
        </label>

        <input asp-for="ProductionDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="ProductionDate"
              class="text-danger"></span>
    </div>

    <!-- تاريخ الانتهاء -->
    <div class="mb-3">
        <label asp-for="ExpiryDate">
            تاريخ الانتهاء
        </label>

        <input asp-for="ExpiryDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="ExpiryDate"
              class="text-danger"></span>
    </div>

    <!-- اسم المجموعة -->
    <div class="mb-3">
        <label asp-for="GroupName">
            اسم المجموعة
        </label>

        <input asp-for="GroupName"
               class="form-control" />

        <span asp-validation-for="GroupName"
              class="text-danger"></span>
    </div>

    <!-- رقم المجموعة -->
    <div class="mb-3">
        <label asp-for="GroupNum">
            رقم المجموعة
        </label>

        <input asp-for="GroupNum"
               class="form-control" />

        <span asp-validation-for="GroupNum"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        حفظ التعديل
    </button>

    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-secondary">
        رجوع
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}