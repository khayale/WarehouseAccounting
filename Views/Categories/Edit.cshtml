@model WarehouseAccounting.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

<form asp-controller="Categories"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Id" class="form-label">
            Category Number
        </label>

        <input asp-for="Id"
               class="form-control" />

        <span asp-validation-for="Id"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Category Name
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
</form>