@model WarehouseAccounting.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<h1>Edit Category</h1>

<form asp-controller="Categories"
      asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           value="@Model.categ_num" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label>Category Number</label>

        <input type="text"
               class="form-control"
               value="@Model.categ_num"
               readonly />
    </div>

    <div class="mb-3">
        <label asp-for="categ_name"></label>

        <input asp-for="categ_name"
               class="form-control" />

        <span asp-validation-for="categ_name"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>