
@model WarehouseAccounting.Models.Category

@{
    ViewData["Title"] = "تعديل المنتج";
}

<h2>تعديل المنتج</h2>

<form asp-controller="Categories"
      asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.Id" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Id">رقم المنتج</label>
        <input asp-for="Id" class="form-control" />
        <span asp-validation-for="Id" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Name">اسم المنتج</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Price">السعر</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Qntt">الكمية</label>
        <input asp-for="Qntt" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Qnty">الوحدة</label>
        <input asp-for="Qnty" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="QntyType">نوع الوحدة</label>
        <input asp-for="QntyType" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Size">الحجم</label>
        <input asp-for="Size" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Color">اللون</label>
        <input asp-for="Color" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Weight">الوزن</label>
        <input asp-for="Weight" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Model">الموديل</label>
        <input asp-for="Model" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Company">الشركة</label>
        <input asp-for="Company" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ProductionDate">تاريخ الإنتاج</label>
        <input asp-for="ProductionDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ExpiryDate">تاريخ الانتهاء</label>
        <input asp-for="ExpiryDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="GroupName">اسم المجموعة</label>
        <input asp-for="GroupName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="GroupNum">رقم المجموعة</label>
        <input asp-for="GroupNum" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        حفظ التعديل
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        رجوع
    </a>

</form>
