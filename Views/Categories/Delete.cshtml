@model WarehouseAccounting.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h1>Delete Category</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this category?
</div>

<dl class="row">
    <dt class="col-sm-3">Category Number</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Category Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>
</dl>

<form asp-controller="Categories" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Categories" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
