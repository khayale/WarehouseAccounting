@model IEnumerable<WarehouseAccounting.Models.Category>

@{
    ViewData["Title"] = "التصنيفات";
}

<h2>التصنيفات</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">إضافة تصنيف</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>الرقم</th>
            <th>اسم التصنيف</th>
            <th>الإجراءات</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">تعديل</a>

                    <a asp-action="Delete" asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">حذف</a>
                </td>
            </tr>
        }
    </tbody>
</table>
