@model IEnumerable<WarehouseAccounting.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<p>
    <a asp-controller="Categories"
       asp-action="Create"
       class="btn btn-primary">
        Create New
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Category Number</th>
            <th>Category Name</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.categ_num</td>

            <td>@item.categ_name</td>

            <td>
                <a asp-controller="Categories"
                   asp-action="Edit"
                   asp-route-id="@item.categ_num">
                    Edit
                </a>
                |
                <a asp-controller="Categories"
                   asp-action="Delete"
                   asp-route-id="@item.categ_num">
                    Delete
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>