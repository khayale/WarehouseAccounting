@model WarehouseAccounting.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<h1>Create Category</h1>

<form asp-controller="Categories"
      asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="categ_num"
               class="form-label">
            Category Number
        </label>

        <input asp-for="categ_num"
               class="form-control" />

        <span asp-validation-for="categ_num"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="categ_name"
               class="form-label">
            Category Name
        </label>

        <input asp-for="categ_name"
               class="form-control" />

        <span asp-validation-for="categ_name"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>